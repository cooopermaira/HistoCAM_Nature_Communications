<config>
	
	<system threads="24" />
  
  <io>
  
    <input_images>D:/4253_3/4253_3_input.txt</input_images>
    <output_log>D:/4253_3/log.txt</output_log>
    <output_image>D:/4253_3/result.png</output_image>
    
  </io>
  
  <registration>
    
    <detector>
      <features>
          <type>ORB</type>
          <params nfeatures="500" scaleFactor="1.0" nlevels="1" edgeThreshold="31"
          firstLevel="0" WTA_K="2" scoreType="HARRIS_SCORE" patchSize="31" fastThreshold="20"/>
      </features>
      <FREAK>False</FREAK>
    </detector>
    
    <image>
      <crop>0.5</crop>
      <scale>0.25</scale>
      <interpolation>CUBIC</interpolation>
      <real>false</real>
      <debayer>true</debayer>
    </image>
    
    <matcher>BRUTEFORCE_HAMMING</matcher>
    <estimator>RANSAC</estimator>
    
  </registration>
  
</config>