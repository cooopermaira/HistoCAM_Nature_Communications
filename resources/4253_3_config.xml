<config>
  
  <processing threads="24" />
  
  <io>
  
    <input_images>C:\4253_3\4253_3_input_small.txt</input_images>
    <output_log>C:\4253_3\log.txt</output_log>
    <output_image>C:\4253_3\result.png</output_image>
    <flat_field_images>
      <twoX>C:\Users\Max Cooper\Documents\calibration\2x_wb.tif</twoX>
    </flat_field_images>

  </io>
  
  <registration>
    
    <detector>
      <features>
          <type>ORB</type>
          <params nfeatures="500" scaleFactor="1.0" nlevels="1" edgeThreshold="31"
          firstLevel="0" WTA_K="2" scoreType="HARRIS_SCORE" patchSize="31" fastThreshold="20"/>
      </features>
      <FREAK>False</FREAK>
    </detector>
    
    <image>
      <crop>0.5</crop>
      <scale>0.25</scale>
      <interpolation>CUBIC</interpolation>
      <real>false</real>
      <debayer>true</debayer>
    </image>
    
    <matcher>BRUTEFORCE_HAMMING</matcher>
    <estimator>RANSAC</estimator>
    
  </registration>
  
</config>


