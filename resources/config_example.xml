<config>
  
  <io>
    <image_list>value1</image_list>
    <output_log>123</output_log>
    <out_image>123</out_image>
  </io>
  <registration>
    
    <detector>
      <features>
          <type>ORB</type>
          <params nfeatures="500" scaleFactor="1.0" nlevels="1" edgeThreshold="31"
          firstLevel="0" WTA_K="2" scoreType="ORB::HARRIS_SCORE" patchSize="31" fastThreshold="20"/>
      </features>
      <FREAK>False</FREAK>
    </detector>
    
    <image>
      <crop>0.5</crop>
      <scale>0.25</scale>
      <interpolation>CUBIC</interpolation>
      <real>False</real>
      <debayer>True</debayer>
    </image>
    
    <matcher>BRUTEFORCE_HAMMING</matcher>
    <estimator>RANSAC</estimator>
    
  </registration>
  
</config>

